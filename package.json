{
  "name": "mynsut",
  "version": "1.0.0",
  "private": true,
  "description": "MyNSUT monorepo containing separate frontend, backend, and shared packages.",
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace frontend\" \"npm run dev --workspace backend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace @mynsut/shared && npm run build --workspace backend && npm run build --workspace frontend",
    "build:shared": "npm run build --workspace @mynsut/shared",
    "build:frontend": "npm run build --workspace frontend",
    "build:backend": "npm run build --workspace backend",
    "lint": "npm run lint --workspace frontend && npm run lint --workspace backend",
    "lint:frontend": "npm run lint --workspace frontend",
    "lint:backend": "npm run lint --workspace backend",
    "format": "npm run format --workspace frontend && npm run format --workspace backend",
    "format:frontend": "npm run format --workspace frontend",
    "format:backend": "npm run format --workspace backend",
    "typecheck": "npm run typecheck --workspace @mynsut/shared && npm run typecheck --workspace backend && npm run typecheck --workspace frontend",
    "typecheck:shared": "npm run typecheck --workspace @mynsut/shared",
    "typecheck:backend": "npm run typecheck --workspace backend",
    "typecheck:frontend": "npm run typecheck --workspace frontend",
    "test": "npm run test --workspace backend && npm run test --workspace frontend",
    "test:backend": "npm run test --workspace backend",
    "test:frontend": "npm run test --workspace frontend",
    "test:e2e": "playwright test",
    "prisma:generate": "npm run prisma:generate --workspace backend",
    "prisma:validate": "npm run prisma:validate --workspace backend",
    "prisma:migrate": "npm run prisma:migrate --workspace backend",
    "prisma:deploy": "npm run prisma:deploy --workspace backend",
    "prisma:studio": "npm run prisma:studio --workspace backend",
    "db:seed": "npm run db:seed --workspace backend"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vanshh4/MyNSUT.git"
  },
  "keywords": [
    "mynsut",
    "nsut",
    "student-platform",
    "nextjs",
    "express",
    "postgresql",
    "prisma"
  ],
  "author": "Vansh Bhardwaj",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/vanshh4/MyNSUT/issues"
  },
  "homepage": "https://github.com/vanshh4/MyNSUT#readme",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "concurrently": "^9.0.0"
  },
  "engines": {
    "node": ">=24.18.0",
    "npm": ">=10.0.0"
  },
  "allowScripts": {}
}
