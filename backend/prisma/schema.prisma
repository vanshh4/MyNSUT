generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum RoleScope {
  GLOBAL
  CLASS
  SOCIETY
}

enum AcademicClassStatus {
  ACTIVE
  ARCHIVED
}

model User {
  id                  String           @id @default(uuid()) @db.Uuid
  email               String           @unique @db.VarChar(320)
  emailVerified       Boolean          @default(false) @map("email_verified")
  googleSubject       String?          @unique @map("google_subject") @db.VarChar(255)
  fullName            String           @map("full_name") @db.VarChar(150)
  profileImageUrl     String?          @map("profile_image_url") @db.Text
  status              UserStatus       @default(ACTIVE)
  onboardingCompleted Boolean          @default(false) @map("onboarding_completed")
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  student             Student?
  sessions            Session[]
  globalRoles          UserGlobalRole[] @relation("UserRoles")
  rolesAssigned        UserGlobalRole[] @relation("RoleAssigner")
  globalRolesRevoked   UserGlobalRole[] @relation("GlobalRoleRevoker")
  classRoles           ClassRole[]      @relation("UserClassRoles")
  classRolesAssigned   ClassRole[]      @relation("ClassRoleAssigner")
  classRolesRevoked    ClassRole[]      @relation("ClassRoleRevoker")
  societyRoles         SocietyRole[]    @relation("UserSocietyRoles")
  societyRolesAssigned SocietyRole[]    @relation("SocietyRoleAssigner")
  societyRolesRevoked  SocietyRole[]    @relation("SocietyRoleRevoker")
  auditLogsPerformed   AuditLog[]       @relation("AuditActor")
  auditLogsReceived    AuditLog[]       @relation("AuditTarget")

  @@index([status])
  @@map("users")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  userAgent  String?   @map("user_agent") @db.Text
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model AcademicClass {
  id            String              @id @default(uuid()) @db.Uuid
  name          String              @db.VarChar(120)
  admissionYear Int                 @map("admission_year")
  branchCode    String              @map("branch_code") @db.VarChar(20)
  section       String              @db.VarChar(20)
  status        AcademicClassStatus @default(ACTIVE)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  students      Student[]
  classRoles    ClassRole[]

  @@unique([admissionYear, branchCode, section])
  @@index([status])
  @@map("academic_classes")
}

model Student {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @unique @map("user_id") @db.Uuid
  classId         String        @map("class_id") @db.Uuid
  umsRollNumber   String        @unique @map("ums_roll_number") @db.VarChar(30)
  admissionYear   Int           @map("admission_year")
  branchCode      String        @map("branch_code") @db.VarChar(20)
  rollNumber      String        @map("roll_number") @db.VarChar(20)
  section         String        @db.VarChar(20)
  graduationYear  Int           @map("graduation_year")
  currentSemester Int?          @map("current_semester")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  academicClass   AcademicClass @relation(fields: [classId], references: [id], onDelete: Restrict)

  profile         StudentProfile?
  privacySettings StudentPrivacySettings?
  academicSummary StudentAcademicSummary?

  @@index([classId])
  @@index([branchCode, admissionYear])
  @@map("students")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(80)
  name        String           @db.VarChar(120)
  description String?          @db.Text
  scope       RoleScope
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  permissions RolePermission[]
  users       UserGlobalRole[]
  classRoles  ClassRole[]
  societyRoles SocietyRole[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(120)
  description String?          @db.Text
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserGlobalRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedBy String?   @map("assigned_by") @db.Uuid
  assignedAt DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy  String?   @map("revoked_by") @db.Uuid
  user       User      @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assigner   User?     @relation("RoleAssigner", fields: [assignedBy], references: [id], onDelete: SetNull)
  revoker    User?     @relation("GlobalRoleRevoker", fields: [revokedBy], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_global_roles")
}

model ClassRole {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  roleId     String        @map("role_id") @db.Uuid
  classId    String        @map("class_id") @db.Uuid
  assignedBy String?       @map("assigned_by") @db.Uuid
  assignedAt DateTime      @default(now()) @map("assigned_at") @db.Timestamptz(6)
  revokedAt  DateTime?     @map("revoked_at") @db.Timestamptz(6)
  revokedBy  String?       @map("revoked_by") @db.Uuid
  user       User          @relation("UserClassRoles", fields: [userId], references: [id], onDelete: Cascade)
  role       Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  class      AcademicClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  assigner   User?         @relation("ClassRoleAssigner", fields: [assignedBy], references: [id], onDelete: SetNull)
  revoker    User?         @relation("ClassRoleRevoker", fields: [revokedBy], references: [id], onDelete: SetNull)

  @@unique([userId, roleId, classId, revokedAt])
  @@index([classId])
  @@index([roleId])
  @@map("class_roles")
}

/// FK to Society deferred to Phase 7 when the Society model is introduced.
model SocietyRole {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  roleId     String    @map("role_id") @db.Uuid
  societyId  String    @map("society_id") @db.Uuid
  assignedBy String?   @map("assigned_by") @db.Uuid
  assignedAt DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy  String?   @map("revoked_by") @db.Uuid
  user       User      @relation("UserSocietyRoles", fields: [userId], references: [id], onDelete: Cascade)
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assigner   User?     @relation("SocietyRoleAssigner", fields: [assignedBy], references: [id], onDelete: SetNull)
  revoker    User?     @relation("SocietyRoleRevoker", fields: [revokedBy], references: [id], onDelete: SetNull)

  @@unique([userId, roleId, societyId, revokedAt])
  @@index([societyId])
  @@index([roleId])
  @@map("society_roles")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String   @map("actor_id") @db.Uuid
  action       String   @db.VarChar(120)
  targetType   String   @map("target_type") @db.VarChar(80)
  targetId     String   @map("target_id") @db.VarChar(255)
  targetUserId String?  @map("target_user_id") @db.Uuid
  metadata     Json?    @db.JsonB
  ipAddress    String?  @map("ip_address") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor        User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  targetUser   User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([targetUserId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}


enum ProfileVisibility {
  PUBLIC
  PLATFORM_ONLY
  PRIVATE
}

enum AcademicSemester {
  SEM_1
  SEM_2
  SEM_3
  SEM_4
  SEM_5
  SEM_6
  SEM_7
  SEM_8
}

enum Grade {
  O
  A_PLUS
  A
  B_PLUS
  B
  C
  P
  F
}

enum ResultStatus {
  PASS
  FAIL
  WITHHELD
}

enum RankType {
  CLASS
  UNIVERSITY
}

model StudentProfile {
  id          String   @id @default(uuid()) @db.Uuid
  studentId   String   @unique @map("student_id") @db.Uuid
  bio         String?  @db.Text
  githubUrl   String?  @map("github_url") @db.VarChar(255)
  linkedinUrl String?  @map("linkedin_url") @db.VarChar(255)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model StudentPrivacySettings {
  id                        String            @id @default(uuid()) @db.Uuid
  studentId                 String            @unique @map("student_id") @db.Uuid
  bioVisibility             ProfileVisibility @default(PLATFORM_ONLY) @map("bio_visibility")
  socialLinksVisibility     ProfileVisibility @default(PLATFORM_ONLY) @map("social_links_visibility")
  academicSummaryVisibility ProfileVisibility @default(PLATFORM_ONLY) @map("academic_summary_visibility")
  semesterResultsVisibility ProfileVisibility @default(PLATFORM_ONLY) @map("semester_results_visibility")
  updatedAt                 DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  student                   Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_privacy_settings")
}

model StudentAcademicSummary {
  id                 String           @id @default(uuid()) @db.Uuid
  studentId          String           @unique @map("student_id") @db.Uuid
  currentCgpa        Float?           @map("current_cgpa")
  totalCreditsEarned Float            @default(0) @map("total_credits_earned")
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  student            Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  results            SemesterResult[]
  ranks              StudentRank[]

  @@map("student_academic_summaries")
}

model SemesterResult {
  id                       String                 @id @default(uuid()) @db.Uuid
  studentAcademicSummaryId String                 @map("student_academic_summary_id") @db.Uuid
  semester                 AcademicSemester
  sgpa                     Float?
  cgpa                     Float?
  creditsEarned            Float                  @map("credits_earned")
  totalCredits             Float                  @map("total_credits")
  status                   ResultStatus
  createdAt                DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  academicSummary          StudentAcademicSummary @relation(fields: [studentAcademicSummaryId], references: [id], onDelete: Cascade)
  grades                   SubjectGrade[]

  @@unique([studentAcademicSummaryId, semester])
  @@map("semester_results")
}

model Subject {
  id          String         @id @default(uuid()) @db.Uuid
  code        String         @unique @db.VarChar(20)
  name        String         @db.VarChar(120)
  credits     Float
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  grades      SubjectGrade[]

  @@map("subjects")
}

model SubjectGrade {
  id               String         @id @default(uuid()) @db.Uuid
  semesterResultId String         @map("semester_result_id") @db.Uuid
  subjectId        String         @map("subject_id") @db.Uuid
  grade            Grade
  semesterResult   SemesterResult @relation(fields: [semesterResultId], references: [id], onDelete: Cascade)
  subject          Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([semesterResultId, subjectId])
  @@map("subject_grades")
}

model StudentRank {
  id                       String                 @id @default(uuid()) @db.Uuid
  studentAcademicSummaryId String                 @map("student_academic_summary_id") @db.Uuid
  rankType                 RankType               @map("rank_type")
  rank                     Int
  batchSize                Int                    @map("batch_size")
  updatedAt                DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  academicSummary          StudentAcademicSummary @relation(fields: [studentAcademicSummaryId], references: [id], onDelete: Cascade)

  @@unique([studentAcademicSummaryId, rankType])
  @@map("student_ranks")
}
