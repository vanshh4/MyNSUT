# Runtime
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_NAME=MyNSUT API
LOG_LEVEL=dev
TRUST_PROXY=false

# Allowed direct frontend origins, comma-separated.
# Browser traffic should normally reach this API through the Next.js same-origin proxy.
FRONTEND_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/mynsut?schema=public

# Authentication
# Use a cryptographically random value of at least 32 characters.
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Google redirects to the Next.js same-origin proxy, which forwards to the backend callback.
GOOGLE_CALLBACK_URL=http://localhost:3000/api/backend/auth/google/callback
FRONTEND_AUTH_SUCCESS_URL=http://localhost:3000/auth/callback
FRONTEND_AUTH_FAILURE_URL=http://localhost:3000/auth/error
SESSION_COOKIE_NAME=mynsut_session

# Optional initial Super Admin seed
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_ROLL_NUMBER=
SUPER_ADMIN_NAME=MyNSUT Administrator

# Object storage - configured in a later phase
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=
