# Runtime
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_NAME=MyNSUT API
LOG_LEVEL=dev

# Allowed frontend origins, comma-separated
FRONTEND_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/mynsut?schema=public

# Authentication - configured in Phase 2
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# Optional initial Super Admin seed
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_ROLL_NUMBER=
SUPER_ADMIN_NAME=MyNSUT Administrator

# Object storage - configured in a later phase
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=
