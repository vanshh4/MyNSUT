# ==============================================================================
# MyNSUT Backend Environment Variables
# ==============================================================================

# Runtime Configuration
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_NAME=MyNSUT API
LOG_LEVEL=dev

# Set TRUST_PROXY=true in production (Render, Vercel proxy, or Cloudflare).
# Required so Express correctly extracts real student client IPs from X-Forwarded-For
# headers for rate limiting and audit logs.
TRUST_PROXY=true

# Allowed direct frontend origins, comma-separated.
# In development: http://localhost:3000
# In production: https://mynsut.com,https://www.mynsut.com
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database (Neon Serverless Postgres)
# DATABASE_URL: Pooled connection string with PgBouncer for API runtime (handles connection spikes)
# Example: postgresql://[user]:[password]@[ep-xyz]-pooler.[region].aws.neon.tech/mynsut?sslmode=require&pgbouncer=true
DATABASE_URL=postgresql://postgres:password@localhost:5432/mynsut?schema=public

# DIRECT_URL: Direct unpooled connection string for Prisma migrations (prisma migrate deploy)
# Example: postgresql://[user]:[password]@[ep-xyz].[region].aws.neon.tech/mynsut?sslmode=require
DIRECT_URL=postgresql://postgres:password@localhost:5432/mynsut?schema=public

# Authentication & Session Security
# AUTH_SECRET must be a cryptographically random secret of at least 32 characters (e.g. openssl rand -hex 32)
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Google OAuth Redirect URIs
# In development: http://localhost:3000/api/backend/auth/google/callback
# In production: https://mynsut.com/api/backend/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/api/backend/auth/google/callback
FRONTEND_AUTH_SUCCESS_URL=http://localhost:3000/auth/callback
FRONTEND_AUTH_FAILURE_URL=http://localhost:3000/auth/error
SESSION_COOKIE_NAME=mynsut_session

# Optional Initial Super Admin Seed (prisma/seed.ts)
SUPER_ADMIN_EMAIL=admin@nsut.ac.in
SUPER_ADMIN_ROLL_NUMBER=2022UCA0001
SUPER_ADMIN_NAME=MyNSUT Administrator

# Distributed Cache & Rate Limiting (Upstash / Redis - Optional)
# Example: rediss://default:[password]@[endpoint].upstash.io:6379
REDIS_URL=

# Error Tracking & Telemetry (Sentry - Optional)
# Example: https://[key]@[host]/[project_id]
SENTRY_DSN=

# Object Storage (Cloudflare R2 / AWS S3 - Optional)
STORAGE_PROVIDER=r2
STORAGE_BUCKET=mynsut-production
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=https://assets.mynsut.com
