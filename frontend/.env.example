# ==============================================================================
# MyNSUT Frontend Environment Variables
# ==============================================================================

# Public Application Metadata
NEXT_PUBLIC_APP_NAME="MyNSUT"

# Canonical Public Web URL of the Frontend Application
# Development: http://localhost:3000
# Production: https://mynsut.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Public API Base URL used by browser-side fetch calls (apiClient)
# In production & development, this MUST point to the same-origin Next.js proxy rewrite path (/api/backend).
# This guarantees session cookies and CSRF headers are sent securely without third-party cookie restrictions.
NEXT_PUBLIC_API_BASE_URL="/api/backend"

# Server-Only Target Backend Origin for Next.js Rewrites (next.config.ts)
# This is NEVER exposed to the client browser.
# Development: http://localhost:4000
# Production: https://mynsut-api.onrender.com
BACKEND_INTERNAL_URL="http://localhost:4000"
